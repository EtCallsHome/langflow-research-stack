# Template only. DO NOT commit a populated .env file.
# Set all actual values in Portainer > Stacks > Environment variables.
POSTGRES_PASSWORD=REPLACE_IN_PORTAINER
LANGFLOW_DATABASE_URL=REPLACE_IN_PORTAINER
LANGFLOW_SUPERUSER_PASSWORD=REPLACE_IN_PORTAINER
LANGFLOW_SECRET_KEY=REPLACE_IN_PORTAINER
BROWSER_TOKEN=REPLACE_IN_PORTAINER

# Inspect existing volumes before entering these.
LANGFLOW_PG_VOLUME=REPLACE_WITH_EXISTING_VOLUME_NAME
LANGFLOW_CONFIG_VOLUME=REPLACE_WITH_EXISTING_VOLUME_NAME
# Create and populate this volume from the old Langflow container's /app/data.
LANGFLOW_RUNTIME_VOLUME=langflow_research_runtime
